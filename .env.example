# --- Backend (server/) ---
# Local development / Cloud SQL Auth Proxy:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cryogenic_inventory
# Or use separate variables instead of DATABASE_URL:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=
# DB_NAME=cryogenic_inventory

# Cloud Run only: connect to Cloud SQL through the /cloudsql unix socket.
# INSTANCE_CONNECTION_NAME=my-project:asia-east1:cryogenic-inventory

# PORT=8080            # Cloud Run sets this automatically
# SKIP_MIGRATIONS=true # skip schema creation on start

# --- Frontend (Vite) ---
# Leave empty when the API is served from the same origin (Cloud Run).
# VITE_API_BASE_URL=
